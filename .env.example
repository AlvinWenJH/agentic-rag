# Application Configuration
APP_NAME=Vectorless RAG
APP_VERSION=1.0.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=vectorless_rag

# Cache Configuration
REDIS_URL=redis://redis:6379/0

# Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_SECURE=false

# AI Configuration
GEMINI_API_KEY=__GEMINI_API_KEY__
GEMINI_MODEL=gemini-2.5-flash

# File Processing Configuration
MAX_FILE_SIZE=50
MAX_PAGES_PER_DOCUMENT=100
SUPPORTED_FORMATS=pdf

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Security Configuration
SECRET_KEY=your_secret_key_here_change_this_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=__DEFAULT_ADMIN_PASSWORD__
DEFAULT_ADMIN_EMAIL=admin@archivist.com
DEFAULT_ADMIN_FULL_NAME=Administrator